# Notion Integration Token (starts with secret_)
# Get this from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_token_here

# The page ID where the database will be created
# From: https://www.notion.so/All-Staff-draft-2e78dac1d83e805fb8c6f28f9b1b456f
# Extract the ID: 2e78dac1d83e805fb8c6f28f9b1b456f
NOTION_PARENT_PAGE_ID=2e78dac1d83e805fb8c6f28f9b1b456f

# Notion Workspace ID
NOTION_WORKSPACE_ID=244adf27-37fa-4f63-b90f-ab12e4c643bb

# Database IDs (will be provided after running setup script)
# Run `npm run setup` first, then paste the database IDs here
NOTION_MEETINGS_DATABASE_ID=
NOTION_AGENDA_ITEMS_DATABASE_ID=
